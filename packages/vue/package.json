{
  "name": "editor.md-next-vue",
  "version": "0.1.0",
  "type": "module",
  "description": "Vue 3 component wrapper for editor.md-next",
  "keywords": [
    "markdown",
    "editor",
    "editormd",
    "vue",
    "vue3",
    "component"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mindoc-org/editor.md-next.git"
  },
  "homepage": "https://github.com/mindoc-org/editor.md-next",
  "bugs": {
    "url": "https://github.com/mindoc-org/editor.md-next/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "editor.md-next": "workspace:^"
  },
  "peerDependencies": {
    "vue": ">=3.2"
  },
  "devDependencies": {
    "vue": "^3.5.13"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
